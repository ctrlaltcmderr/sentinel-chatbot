# Sentinel Chatbot - Environment Configuration

# Application Server
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development

# Database Connection (SQLite default, modular for PostgreSQL)
DATABASE_URL=sqlite:///./sentinel.db
# For PostgreSQL in production:
# DATABASE_URL=postgresql://user:password@localhost:5432/sentinel_db

# File Storage & Uploads
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=10

# Security & Admin Access
ADMIN_API_KEY=sentinel-enterprise-key-2026
SECRET_KEY=sentinel-super-secret-key-change-in-production

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Frontend API URL
VITE_API_URL=http://127.0.0.1:8000

